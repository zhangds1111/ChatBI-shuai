{
  "BUSINESS_RULES": [
    {
      "type": "whitelist",
      "trigger_keywords": [
        "销售额",
        "收入",
        "营收",
        "GMV",
        "销售收入"
      ],
      "force_include": [
        "amz_order_items.item_amount",
        "amz_order_items.purchase_date",
        "amz_order_items.order_status"
      ],
      "reason": "销售额口径用 item_amount(不含税),并必须带 order_status 以排除 Canceled/Pending"
    },
    {
      "type": "blacklist",
      "trigger_keywords": [
        "销售额",
        "收入",
        "营收",
        "GMV",
        "销售收入"
      ],
      "force_exclude": [
        "amz_order_items.tax_amount",
        "amz_order_items.shipping_amount",
        "amz_traffic_daily.ordered_sales"
      ],
      "reason": "销售额不含税、不含运费,且不用流量报告的 ordered_sales"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "含运费",
        "含税",
        "含税销售额"
      ],
      "force_include": [
        "amz_order_items.shipping_amount",
        "amz_order_items.tax_amount"
      ],
      "reason": "用户明确要求含运费/含税时才引入对应字段"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "订单量",
        "订单数",
        "出单量",
        "客单价"
      ],
      "force_include": [
        "amz_order_items.order_id",
        "amz_order_items.order_status"
      ],
      "reason": "订单量需 COUNT(DISTINCT order_id) 并过滤订单状态"
    },
    {
      "type": "conditional",
      "trigger_keywords": [
        "人民币",
        "汇率",
        "折算",
        "统一币种",
        "换算",
        "利润",
        "毛利",
        "站点销售额",
        "各站点",
        "跨站点"
      ],
      "force_include": [
        "exchange_rates.rate_to_cny",
        "exchange_rates.rate_date",
        "exchange_rates.currency"
      ],
      "reason": "金额均为站点原币,汇总人民币或跨站点比较必须关联 exchange_rates"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "成本",
        "毛利",
        "毛利率",
        "利润",
        "COGS"
      ],
      "force_include": [
        "dim_products.unit_cost",
        "dim_products.head_freight_cost",
        "amz_order_items.quantity"
      ],
      "reason": "商品成本 = (unit_cost + head_freight_cost) × 销量"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "平台费用",
        "佣金",
        "FBA费",
        "仓储费",
        "回款",
        "结算",
        "到账",
        "利润"
      ],
      "force_include": [
        "amz_settlement.fee_type",
        "amz_settlement.amount",
        "amz_settlement.posted_date"
      ],
      "reason": "平台费用/回款来自结算表,需按 fee_type 区分"
    },
    {
      "type": "blacklist",
      "trigger_keywords": [
        "平台费用",
        "佣金",
        "FBA费",
        "仓储费"
      ],
      "force_exclude": [
        "amz_settlement.id"
      ],
      "reason": "平台费用只含 commission、fba_fee、storage_fee(不含 promotion 促销、refund 退款);结算自增 id 无业务含义"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "广告",
        "ACOS",
        "ROAS",
        "CPC",
        "TACOS",
        "广告花费",
        "广告费"
      ],
      "force_include": [
        "amz_ads_daily.spend",
        "amz_ads_daily.report_date"
      ],
      "reason": "广告指标以广告日报为准"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "ACOS",
        "ROAS",
        "广告销售额",
        "TACOS"
      ],
      "force_include": [
        "amz_ads_daily.sales_7d"
      ],
      "reason": "ACOS/ROAS 需要 7 天归因广告销售额"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "CPC",
        "点击率",
        "CTR",
        "广告转化率"
      ],
      "force_include": [
        "amz_ads_daily.clicks",
        "amz_ads_daily.impressions",
        "amz_ads_daily.orders_7d"
      ],
      "reason": "CPC、点击率、广告转化率需要点击、曝光、广告订单"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "会话",
        "流量",
        "访问量",
        "转化率",
        "CVR"
      ],
      "force_include": [
        "amz_traffic_daily.sessions",
        "amz_traffic_daily.units_ordered",
        "amz_traffic_daily.report_date"
      ],
      "reason": "转化率 = 下单件数 ÷ 会话数,来自流量日报"
    },
    {
      "type": "blacklist",
      "trigger_keywords": [
        "转化率",
        "CVR",
        "Unit Session"
      ],
      "force_exclude": [
        "amz_order_items.quantity",
        "amz_ads_daily.orders_7d"
      ],
      "reason": "店铺转化率不用订单表销量或广告订单,口径与后台不一致;「广告转化率」除外"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "Buy Box",
        "购物车",
        "黄金购物车"
      ],
      "force_include": [
        "amz_traffic_daily.buy_box_pct",
        "amz_traffic_daily.sessions"
      ],
      "reason": "Buy Box 占比需按会话数加权"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "库存",
        "可售",
        "可售天数",
        "库龄",
        "滞销",
        "补货",
        "呆滞"
      ],
      "force_include": [
        "amz_fba_inventory.snapshot_date",
        "amz_fba_inventory.available_qty"
      ],
      "reason": "库存是快照数据,必须带 snapshot_date 并取最新快照"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "库龄",
        "高库龄",
        "滞销",
        "呆滞",
        "老库存"
      ],
      "force_include": [
        "amz_fba_inventory.age_181_270_qty",
        "amz_fba_inventory.age_271_365_qty",
        "amz_fba_inventory.age_365_plus_qty"
      ],
      "reason": "高库龄 = 库龄 181 天以上三段之和"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "可售天数",
        "库存天数",
        "周转天数"
      ],
      "force_include": [
        "amz_order_items.quantity",
        "amz_order_items.purchase_date"
      ],
      "reason": "可售天数 = 可售库存 ÷ 近 30 天日均销量"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "退货",
        "退货率",
        "退货原因"
      ],
      "force_include": [
        "amz_returns.quantity",
        "amz_returns.return_date"
      ],
      "reason": "退货率 = 退货件数 ÷ 同期销量"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "站点",
        "国家",
        "各站点",
        "哪个站点"
      ],
      "force_include": [
        "dim_stores.marketplace"
      ],
      "reason": "站点/国家维度使用 dim_stores.marketplace,库中没有 country 字段"
    },
    {
      "type": "whitelist",
      "trigger_keywords": [
        "品类",
        "类目",
        "哪类产品"
      ],
      "force_include": [
        "dim_products.category"
      ],
      "reason": "品类维度使用 dim_products.category"
    },
    {
      "type": "blacklist",
      "trigger_keywords": [
        "库存",
        "可售",
        "库龄"
      ],
      "force_exclude": [
        "amz_settlement.id",
        "amz_returns.id"
      ],
      "reason": "自增主键无业务含义,不参与召回"
    }
  ]
}