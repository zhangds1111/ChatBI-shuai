        "厨房用品",
        "宠物用品",
        "家居收纳",
        "家居照明",
        "户外运动"
      ],
      "note": "流量表需通过 ASIN 关联,须先对 dim_products 按 (store_id, asin) 去重;结算表的 MSKU 可为空(店铺级费用如仓储费),这部分费用按品类分组时会落入空值组,需单独说明",
      "field": "dim_products.category",
      "sql_by_table": {
        "amz_order_items": {
          "group_expr": "d.category",
          "join": "JOIN dim_products d ON f.store_id = d.store_id AND f.msku = d.msku",
          "distinct_values": 5,
          "null_groups": 0
        },
        "amz_ads_daily": {
          "group_expr": "d.category",
          "join": "JOIN dim_products d ON f.store_id = d.store_id AND f.msku = d.msku",
          "distinct_values": 5,
          "null_groups": 0
        },
        "amz_traffic_daily": {
          "group_expr": "d.category",
          "join": "JOIN (SELECT DISTINCT store_id, asin, sku, category, owner AS product_owner, status AS product_status, parent_asin FROM dim_products) d ON f.store_id = d.store_id AND f.asin = d.asin",
          "distinct_values": 5,
          "null_groups": 0
        },
        "amz_fba_inventory": {
          "group_expr": "d.category",
          "join": "JOIN dim_products d ON f.store_id = d.store_id AND f.msku = d.msku",
          "distinct_values": 5,
          "null_groups": 0
        },
        "amz_settlement": {
          "group_expr": "d.category",
          "join": "LEFT JOIN dim_products d ON f.store_id = d.store_id AND f.msku = d.msku",
          "distinct_values": 6,
          "null_groups": 1
        },
        "amz_returns": {
          "group_expr": "d.category",
          "join": "JOIN dim_products d ON f.store_id = d.store_id AND f.msku = d.msku",
          "distinct_values": 5,
          "null_groups": 0
        }
