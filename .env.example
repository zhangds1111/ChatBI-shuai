OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="your_openai_base_url"
LLM_MODEL="your_llm_model"
EMBEDDING_MODEL="your_embedding_model"

DB_HOST="localhost"
DB_PORT="3307"
# 生产请使用只读账号 chatbi_ro（创建方式见 docs/security.md），仅授予 9 张白名单表 SELECT
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="chatbi_mvp"
DB_CONNECT_TIMEOUT="5"
DB_READ_TIMEOUT="8"
DB_WRITE_TIMEOUT="8"
DB_POOL_SIZE="5"
DB_POOL_MAX_OVERFLOW="5"
DB_POOL_TIMEOUT="3"
DB_SLOW_QUERY_THRESHOLD_MS="200"

# ---- 安全（SQL 校验 / 行级权限 / 令牌）----
# 返回行数上限：无 LIMIT 自动补齐，超过上限压到上限
MAX_ROWS="1000"
# 会话级执行超时（毫秒），每次查询前 SET SESSION max_execution_time
QUERY_TIMEOUT_MS="30000"
# 令牌签名密钥（HMAC-SHA256），生产必配；生成令牌见 scripts/make_token.py
AUTH_SECRET="change_me_to_a_long_random_secret"
# 开发模式：true 时允许无令牌访问并以 demo_admin 身份执行；默认关闭
ALLOW_DEMO_ADMIN="false"
# 表白名单 / 函数黑名单 / 敏感列策略文件（含 allowed_tables 等，见 docs/security.md）
SECURITY_POLICY_PATH="security_policy.json"
# 单查询最大表数 / 子查询嵌套深度（可选，默认 6 / 5）
# MAX_TABLES_PER_QUERY="6"
# MAX_SUBQUERY_DEPTH="5"
# dim_stores.owner -> store_id 映射缓存 TTL（秒），默认 600（10 分钟）
# STORE_CACHE_TTL_SECONDS="600"

# ---- 功能开关 ----
# Schema Linking 动态 Schema 注入（默认开启；置 false 回退全量 Schema）
FEATURE_SCHEMA_LINKING="true"

# ---- LangSmith tracing（可选，缺省关闭）----
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="chatbi-dev"
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
